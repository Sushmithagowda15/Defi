# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Configuration
JWT_SECRET=defilend_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=24h

# Database Configuration (relative to backend/)
DB_PATH=./data/defilend.db

# Express Proxy Trust Configuration
# Set to 'false' if directly internet-facing without a reverse proxy.
# Set to '1', 'loopback', 'true', or trusted proxy CIDR list when behind a reverse proxy (e.g. Nginx, Cloudflare, ALB).
TRUST_PROXY=loopback

# Email / Nodemailer Service Configuration (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Frontend URL (for verification & password reset links)
FRONTEND_URL=http://localhost:5173

# Additional CORS Allowed Origins (comma-separated, for production)
CORS_ORIGINS=https://your-frontend-domain.com
